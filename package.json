{
  "name": "@waaark/luge",
  "version": "1.0.0",
  "description": "Front-end animation plugin for uncreative developers",
  "author": "Antoine Wodniack <hello@wodniack.dev> (https://wodniack.dev)",
  "homepage": "https://luge.cool",
  "repository": {
    "type": "git",
    "url": "https://github.com/AntoineW/luge.git"
  },
  "license": "GPL-3.0-only",
  "files": [
    "/dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "source": "src/js/luge.js",
  "exports": {
    ".": {
      "require": "./dist/js/luge.cjs",
      "default": "./dist/js/luge.modern.js"
    },
    "./dist/*": "./dist/*",
    "./css": "./dist/css/luge.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/js/luge.cjs",
  "module": "./dist/js/luge.module.js",
  "unpkg": "./dist/js/luge.umd.js",
  "scripts": {
    "build": "run-s build:pkg build:umd build:scss",
    "build:pkg": "node scripts/build-library.mjs pkg",
    "build:umd": "node scripts/build-library.mjs umd",
    "build:scss": "run-s scss:build scss:postcss",
    "dev": "run-p dev:*",
    "dev:js": "node scripts/build-library.mjs pkg --watch",
    "dev:scss": "run-s scss:build scss:watch",
    "scss:build": "sass --style=compressed --no-source-map src/scss:dist/css",
    "scss:watch": "sass --watch src/scss:dist/css",
    "scss:postcss": "postcss -d dist/css/ dist/css/",
    "release:pack": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "autoprefixer": "10.4.21",
    "bowser": "2.11.0",
    "lenis": "1.3.5",
    "microbundle": "0.15.1",
    "npm-run-all": "4.1.5",
    "postcss": "8.5.32",
    "postcss-cli": "11.0.1",
    "sass": "1.89.2"
  },
  "overrides": {
    "rollup-plugin-terser": {
      "serialize-javascript": "7.1.4"
    }
  }
}
